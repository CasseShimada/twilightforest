{
  "schemaVersion": 1,
  "id": "twilightforest",
  "version": "${version}",
  "name": "The Twilight Forest",
  "description": "An enchanted forest dimension.",
  "authors": [
    "Benimatic",
    "AtomicBlom",
    "Drullkus",
    "Killer_Demon",
    "quadraxis",
    "Tamaized",
    "williewillus",
    "Andromander",
    "GizmoTheMoonPig",
    "jodlodi"
  ],
  "license": "LGPL-2.1",
  "icon": "twilightforest_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "twilightforest.TwilightForestMod"
    ],
    "client": [
      "twilightforest.client.TwilightForestClient"
    ],
    "jei_mod_plugin": [
      "twilightforest.compat.jei.JEICompat"
    ],
    "jade": [
      "twilightforest.compat.jade.JadeCompat"
    ]
  },
  "mixins": [
    "twilightforest.mixins.json"
  ],
  "accessWidener": "twilightforest.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  },
  "suggests": {
    "jei": ">=30.2.0.18",
    "jade": ">=26.2.9",
    "diggusmaximus": ">=1.5.9-beta.1",
    "wthit": ">=20.0.0"
  },
  "custom": {
    "twilightforest:api_version": "${api_version}"
  }
}
